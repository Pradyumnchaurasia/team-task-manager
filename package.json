{
  "name": "team-task-manager-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:frontend": "npm run build --workspace=frontend",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=backend/prisma/schema.prisma",
    "build": "npm run build:frontend && npm run prisma:generate",
    "start": "npm run prisma:push && node backend/src/app.js"
  },
  "dependencies": {
    "prisma": "^5.14.0"
  }
}
