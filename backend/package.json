{
  "name": "team-task-manager-backend",
  "version": "1.0.0",
  "description": "REST API backend for Team Task Manager",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node src/utils/seed.js",
    "prisma:studio": "prisma studio",
    "build": "npm install --prefix frontend && npm run build --prefix frontend && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
